# MIYAZAKI PRIVATE (/private). Set these in Vercel, not here.
# With the endpoint set, /private/request posts the form to it.
# With only the address set, the page shows a mailto button instead.
# With neither, the page shows "Requests open shortly."
# Never commit a real address or endpoint to the repository.
NEXT_PUBLIC_REQUEST_FORM_ENDPOINT=
NEXT_PUBLIC_CONTACT_EMAIL=
